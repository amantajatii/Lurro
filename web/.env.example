# Public Reown/WalletConnect project ID enables Rainbow mobile QR connections.
# Create one at https://dashboard.reown.com ; allowlist your deployed domain.
# Browser extension wallets work without this value.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Fixed per build; rebuild/redeploy to change network. Invalid values fail closed.
NEXT_PUBLIC_LURRO_NETWORK=mainnet
# Keep false until the release candidate, signer and capped budget receive owner review.
NEXT_PUBLIC_LURRO_MAINNET_WRITES_ENABLED=false

# Optional public RPC endpoint for the selected network; HTTPS or loopback HTTP.
# Do not include private credentials: this URL is embedded in the browser bundle.
NEXT_PUBLIC_LURRO_RPC_URL=
